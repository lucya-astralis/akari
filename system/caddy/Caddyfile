# Akari OS: HTTPS in front of akarid, which listens on 127.0.0.1:8130 only.
# The certificate comes from Caddy's own CA (tls internal), for whatever name
# or address the browser used: browsers ask once whether to trust it.
{
	skip_install_trust
}

:443 {
	tls internal {
		on_demand
	}
	reverse_proxy 127.0.0.1:8130
}

:80 {
	redir https://{host}{uri} permanent
}

# Lucent in a container on this machine (Docker → Lucent, docker.py) calls
# Akari here: plain http, because Lucent checks certificates and the one above
# is Caddy's own. Only Lucent's tool API, which answers only to the Lucent
# Akari is paired with (signed requests); everything else is not here.
:8131 {
	# only from this machine and its containers (Docker's networks are
	# 172.16.0.0/12 by default): the LAN does not see the door at all
	@lucent {
		path /lucent/v1/*
		remote_ip 127.0.0.0/8 172.16.0.0/12
	}
	handle @lucent {
		reverse_proxy 127.0.0.1:8130
	}
	handle {
		respond 404
	}
}
