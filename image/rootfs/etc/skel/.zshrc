# ~/.zshrc: your shell. Akari OS gives you oh-my-zsh with powerlevel10k;
# settings for it go above the `source` line, your own lines below.
# AKARI_QUIET=1                 # no fastfetch when a terminal opens
# AKARI_THEME=robbyrussell      # another oh-my-zsh theme
# AKARI_PLUGINS=(git z)         # other oh-my-zsh plugins
source /usr/share/akari/zsh/akari.zsh

# `p10k configure` makes your own prompt in ~/.p10k.zsh
