// Akari OS: the system-wide fastfetch look. Copy to ~/.config/fastfetch/config.jsonc to change it.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/akari/fastfetch/logo.txt",
    // $1: the wings, in Facet's violet; $2: head and tail, white
    "color": { "1": "38;5;141", "2": "97" },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;5;141", "title": "97" },
    "key": { "width": 13 },
    "bar": { "char": { "elapsed": "━", "total": "━" }, "width": 14 },
    "percent": { "type": 3, "color": { "green": "38;5;114", "yellow": "38;5;221", "red": "38;5;203" } }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "custom", "format": "\u001b[38;5;240m────────────────────────────\u001b[0m" },
    { "type": "os", "key": "System", "format": "{pretty-name} {arch}" },
    { "type": "kernel", "key": "Kernel", "format": "{release}" },
    { "type": "custom", "key": "Desktop", "format": "Akari · Facet 1.8" },
    { "type": "shell", "key": "Shell" },
    { "type": "command", "key": "Terminal", "text": "echo \"${TERM_PROGRAM:-$TERM}\"" },
    { "type": "uptime", "key": "Läuft seit" },
    { "type": "packages", "key": "Pakete" },
    { "type": "cpu", "key": "CPU", "format": "{name} ({cores-logical})" },
    { "type": "memory", "key": "Speicher" },
    { "type": "disk", "key": "Home", "folders": "/data", "format": "{size-used} / {size-total} {size-percentage-bar}" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
  ]
}
