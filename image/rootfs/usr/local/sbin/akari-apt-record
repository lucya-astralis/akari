#!/bin/sh
# Akari OS: the packages installed on top of the image, kept in the volume.
# akarid installs them again when it starts on a new image (software.py).
set -e
base=/usr/share/akari/apt/baseline.list
dir=/data/system/apt
[ -r "$base" ] && [ -d /data/system ] || exit 0
mkdir -p "$dir"
apt-mark showmanual | sort -u | comm -13 "$base" - > "$dir/packages.list.tmp"
mv "$dir/packages.list.tmp" "$dir/packages.list"
# a package that made a system user replaced the /etc/passwd link: give it back to akarid
for f in passwd group shadow gshadow; do
  if [ ! -L "/etc/$f" ]; then
    cd /opt/akari && PYTHONPATH=/opt/akari /opt/venv/bin/python -c 'from akari import accounts; accounts.adopt_etc()' || true
    break
  fi
done
