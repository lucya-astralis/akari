#!/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = purge ] || [ "$1" = abort-install ]; then
	for f in /etc/update-motd.d/10-uname /etc/motd /etc/issue; do
		if dpkg-divert --listpackage "$f" | grep -qx akari; then
			rm -f "$f"
			dpkg-divert --package akari --quiet --remove --rename --divert "$f.debian" "$f"
		fi
	done
fi
if [ "$1" = purge ]; then
	# account pictures, Lucent pairing, what Akari knows about accounts (the accounts stay)
	rm -rf /var/lib/akari
	rm -f /run/issue.d/50-akari.issue
fi
if [ -d /run/systemd/system ]; then
	deb-systemd-invoke try-restart caddy.service || true
fi
#DEBHELPER#
exit 0
