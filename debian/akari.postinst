#!/bin/sh
set -e
# Debian's words after login make way for Akari's welcome (update-motd.d/10-akari):
# the uname line and the licence text. Diverted, not overwritten: removing akari
# puts them back. The line before login is akari-base's (its getty drop-in), so
# /etc/issue stays Debian's; 0.15 diverted it too, that is undone here.
if [ "$1" = configure ]; then
	for f in /etc/update-motd.d/10-uname /etc/motd; do
		dpkg-divert --package akari --quiet --add --rename --divert "$f.debian" "$f"
	done
	[ -e /etc/motd ] || : > /etc/motd
	if dpkg-divert --listpackage /etc/issue | grep -qx akari; then
		rm -f /etc/issue
		dpkg-divert --package akari --quiet --remove --rename --divert /etc/issue.debian /etc/issue
	fi
fi
#DEBHELPER#
if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
	# Caddy reads Akari's Caddyfile (caddy.service.d/akari.conf) from now on;
	# debhelper's snippet above has reloaded systemd
	deb-systemd-invoke try-restart caddy.service || true
fi
exit 0
